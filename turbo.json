{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["FIREBASE_SERVICE_ACCOUNT", "FIREBASE_WEB_CONFIG", "FIRESTORE_EMULATOR_HOST", "FIREBASE_AUTH_EMULATOR_HOST", "FIREBASE_PROJECT_ID", "FORKD_SEED_SAMPLE", "FORKD_STORE", "SESSION_SECRET", "NODE_ENV"],
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": [".next/**", "!.next/cache/**", "dist/**"] },
    "dev": { "cache": false, "persistent": true },
    "typecheck": { "dependsOn": ["^typecheck"] },
    "test": { "outputs": [] },
    "lint": {}
  }
}

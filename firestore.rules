rules_version = '2';
// All reads and writes go through the Forkd server (Firebase Admin SDK), which bypasses these rules.
// Browsers get no direct access, so the public web API key can't be used to read or change data.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

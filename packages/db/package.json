{
  "name": "@forkd/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate": "tsx --env-file-if-exists=../../.env src/migrate.ts",
    "seed": "tsx --env-file-if-exists=../../.env src/seed.ts",
    "studio": "drizzle-kit studio",
    "typecheck": "tsc -p tsconfig.json",
    "demo:build": "node scripts/build-demo.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.3.16",
    "@forkd/core": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@forkd/config": "workspace:*",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.20.0"
  }
}

{
  "name": "forkd",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@forkd/web",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "worker": "pnpm --filter @forkd/worker start",
    "emulators": "firebase emulators:start --only firestore,auth --project demo-forkd"
  },
  "devDependencies": {
    "turbo": "2.11.10",
    "typescript": "5.9.3",
    "@types/node": "^22.10.0"
  }
}

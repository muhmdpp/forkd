# Leave everything empty to run in demo mode (in-memory sample data, guest sign-in).

# Firebase (Vercel: Project → Settings → Environment Variables)
# 1. Firebase console → Project settings → Service accounts → Generate new private key.
#    Paste the WHOLE JSON file as one value. Secret: never commit it.
FIREBASE_SERVICE_ACCOUNT=
# 2. Firebase console → Project settings → General → Your apps → Web app → the firebaseConfig = {...} block.
#    Paste it as is (JSON or the JavaScript object both work). This one is public.
FIREBASE_WEB_CONFIG=

# Local development against the Firebase emulators (firebase emulators:start):
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_PROJECT_ID=demo-forkd

# Optional: set to 0 to stop the app filling an empty Firestore with the Kozhikode sample data.
# FORKD_SEED_SAMPLE=0

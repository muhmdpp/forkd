# Postgres connection. docker compose up -d gives you this one.
DATABASE_URL=postgres://forkd:forkd@localhost:5432/forkd

# Auth. Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000

# Optional: Google sign-in. Leave empty to use email + password only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
